# NXG Life Group — funnel configuration (copy to .env.local for dev)

# E.164 or display format — shown on page and used in tel: links (digits only in tel:)
VITE_BUSINESS_PHONE=+15555550100

# Google Calendar (or Calendly) booking URL — secondary CTA
VITE_CALENDAR_URL=https://calendar.google.com/calendar/appointments/schedules/YOUR_LINK

# POST endpoint for leads (Zapier/Make/n8n/custom API). JSON body — see docs/automation-workflows.md
VITE_LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXX/YYYYY/

# Canonical site URL for links and meta (no trailing slash)
VITE_SITE_URL=https://nxglifegroup.com

# Optional — loaded only if set in index.html injection pattern
# VITE_META_PIXEL_ID=
# VITE_GTM_ID=

# NXG Life Group — funnel configuration
#
# ── FRONT-END (build-time, must start with VITE_) ─────────────────────────────
# Copy to .env.local for local dev.

# Google Calendar / Calendly booking URL — secondary "Book a strategy session" CTA
VITE_CALENDAR_URL=https://calendar.google.com/calendar/appointments/schedules/YOUR_LINK

# Canonical site URL for links and meta (no trailing slash)
VITE_SITE_URL=https://nxglifegroup.com

# OPTIONAL override: route lead submissions to your own webhook (Make/Zapier/n8n)
# instead of the built-in Netlify function. Leave unset to use the instant-callback
# function at /.netlify/functions/trigger-retell-call
# VITE_LEAD_WEBHOOK_URL=

# Optional analytics
# VITE_META_PIXEL_ID=
# VITE_GTM_ID=

# ── SERVER-SIDE (set in Netlify → Site settings → Environment variables) ──────
# These power the instant Greece (Retell) callback. They are NOT prefixed with
# VITE_ and are never exposed to the browser. Do not put real values in this file
# or commit them — add them in the Netlify dashboard.
#
# RETELL_API_KEY=your_retell_secret_api_key
# RETELL_FROM_NUMBER=+16195551234        # the Retell number Greece calls FROM (E.164)
# RETELL_AGENT_ID=agent_xxxxxxxx         # optional: force Greece via override_agent_id
# LEAD_FORWARD_WEBHOOK=                  # optional: also POST the raw lead to a CRM/Make hook

# ── SMS confirmations via Twilio (optional; requires A2P 10DLC registration) ──
# Used by /.netlify/functions/send-confirmation-sms. A Sole-Proprietor brand is
# enough — no LLC/EIN needed. Set these in the Netlify dashboard, not this file.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+16195551234        # your registered Twilio number (E.164)
# BUSINESS_NAME=NXG Life Group

# ── Supabase (lead storage for the admin dashboard) ──────────────────────────
# SERVER (Netlify functions) — service role bypasses RLS, keep secret:
# SUPABASE_URL=https://bhuclkecnnbsovbdplwe.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=            # Supabase → Project Settings → API → service_role (secret)
#
# CLIENT (dashboard build) — safe to expose, publishable key:
# VITE_SUPABASE_URL=https://bhuclkecnnbsovbdplwe.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_9RoqfSHEXwWfCFHEVVOZvA_gWmbyD0c
